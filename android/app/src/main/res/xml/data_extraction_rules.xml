<?xml version="1.0" encoding="utf-8"?>
<!-- Même règle pour Android 12 et suivants : sauvegarde Google et transfert vers un
     nouveau téléphone emportent le carnet, jamais la clé Gemini ni le jeton kDrive. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_webview/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_webview/" />
    </device-transfer>
</data-extraction-rules>
