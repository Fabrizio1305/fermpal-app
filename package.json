{
  "name": "fermpal",
  "version": "2.0.0",
  "private": true,
  "description": "FermPal — carnet de fermentation maison pour Android (local, sans compte).",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "node mobile/scripts/copy-wasm.mjs && vite --config mobile/vite.config.js",
    "build": "node mobile/scripts/copy-wasm.mjs && vite build --config mobile/vite.config.js",
    "preview": "vite preview --config mobile/vite.config.js",
    "sync": "npm run build && cap sync android",
    "test": "node --import ./tests/setup-alias.mjs --test tests/*.test.mjs",
    "test:e2e": "playwright test -c mobile/playwright.config.js",
    "check-hosts": "node mobile/scripts/check-hosts.mjs",
    "i18n:check": "node scripts/i18n-check.mjs --strict",
    "apk": "bash mobile/scripts/apk.sh"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@playwright/test": "^1.61.1",
    "@vitejs/plugin-react": "^6.1.1",
    "jeep-sqlite": "^2.8.0",
    "sql.js": "^1.11.0",
    "vite": "^8.3.0"
  }
}
